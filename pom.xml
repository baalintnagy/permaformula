<?xml version="1.0" encoding="utf-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath />
    </parent>
    <groupId>org.permaformula</groupId>
    <artifactId>permaformula-parent</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>
    <name>PermaFormula</name>
    <modules>
        <module>render-contract</module>
        <module>renderer-core</module>
        <module>renderer-service</module>
        <module>permaformula-api</module>
    </modules>
    <properties>
        <java.version>25</java.version>
        <permaformula.build.directory>target</permaformula.build.directory>
        <spring-boot.version>4.0.5</spring-boot.version>
        <grpc.version>1.84.0</grpc.version>
        <protobuf.version>4.36.2</protobuf.version>
        <playwright.version>1.59.0</playwright.version>
        <graaljs.version>25.0.2</graaljs.version>
        <lombok.version>1.18.48</lombok.version>
        <spotless.version>3.10.4</spotless.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <checkstyle.version>14.0.0</checkstyle.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.permaformula</groupId>
                <artifactId>render-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.permaformula</groupId>
                <artifactId>renderer-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
    </dependencies>
    <build>
        <directory>${permaformula.build.directory}</directory>
        <plugins>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                            <include>tools/antisamy-trial/src/main/java/**/*.java</include>
                        </includes>
                        <excludes>
                            <exclude>**/target/**</exclude>
                            <exclude>**/.apt_generated/**</exclude>
                        </excludes>
                        <replaceRegex>
                            <name>Prefer simple quoted strings</name>
                            <searchRegex>(?m)^([ ]*)&quot;&quot;&quot;\r?\n(?=[^\r\n]{0,92}\\\r?$)\1([^&quot;\\\r\n]*)\\\r?\n\1&quot;&quot;&quot;</searchRegex>
                            <replacement>$1&quot;$2&quot;</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Keep initial method call with its receiver</name>
                            <searchRegex>(?s)(&quot;&quot;&quot;(?:[^&quot;\\]++|\\.|(?!&quot;&quot;&quot;)&quot;)*+&quot;&quot;&quot;|&quot;(?:[^&quot;\\\r\n]++|\\.)*+&quot;|'(?:[^'\\\r\n]++|\\.)*+'|/\*.*?\*/|//[^\r\n]*)|(\b[A-Za-z_$][\w$]*(?:\.[A-Za-z_$][\w$]*)*)\r?\n[ ]+(\.[A-Za-z_$][\w$]*[ ]*\()</searchRegex>
                            <replacement>$1$2$3</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Keep literal with its initial method call</name>
                            <searchRegex>(?s)(&quot;&quot;&quot;(?:[^&quot;\\]++|\\.|(?!&quot;&quot;&quot;)&quot;)*+&quot;&quot;&quot;|'(?:[^'\\\r\n]++|\\.)*+'|/\*.*?\*/|//[^\r\n]*)|(&quot;(?:[^&quot;\\\r\n]++|\\.)*+&quot;)(?:\r?\n[ ]+(\.[A-Za-z_$][\w$]*[ ]*\())?</searchRegex>
                            <replacement>$1$2$3</replacement>
                        </replaceRegex>
                        <eclipse>
                            <version>4.41</version>
                            <file>${maven.multiModuleProjectDirectory}/eclipse/java-style.properties</file>
                        </eclipse>
                        <jsr223>
                            <name>Indent text blocks one continuation level</name>
                            <dependency>org.apache.groovy:groovy-jsr223:4.0.32</dependency>
                            <engine>groovy</engine>
                            <script><![CDATA[
source.replaceAll(/(?m)^([ ]*)([^\r\n]+\r?\n)([ ]*)"""\r?\n((?s:.*?))^([ ]*)"""/) {
    whole, indent, precedingLine, openingIndent, body, closingIndent ->
        def statement = precedingLine.trim()
        def targetIndent = statement.endsWith('=') || statement in ['return', 'yield', 'throw']
            ? '%s    '.formatted(indent) : openingIndent
        def contentIndents = body.readLines().findAll { !it.isBlank() }
            .collect { it.takeWhile { character -> character == ' ' }.size() }
        def incidentalIndent = (contentIndents + [closingIndent.size()]).min()
        def indentation = '(?m)^ {0,%d}'.formatted(incidentalIndent)
        def content = body.replaceAll(indentation, targetIndent).replaceAll('(?m)^[ ]+$', '')
        '%s%s%s"""\n%s%s"""'.formatted(indent, precedingLine, targetIndent,
            content, targetIndent)
}
                            ]]></script>
                        </jsr223>
                        <replaceRegex>
                            <name>Wrap long quoted string assignments</name>
                            <searchRegex>(?m)^(?=[^\r\n]{101})([ ]*)((?:(?:public|protected|private|static|final)\s+)*String\s+\w+\s*=|(?:description|example)\s*=)[ ]+(&quot;(?:\\.|[^&quot;\\\r\n])*&quot;[^\r\n]*)$</searchRegex>
                            <replacement>$1$2
$1    $3</replacement>
                        </replaceRegex>
                        <removeUnusedImports />
                        <forbidWildcardImports />
                        <importOrder>
                            <order>\#,java,</order>
                        </importOrder>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>check-formatting</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle-plugin.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>${checkstyle.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/checkstyle/checkstyle.xml</configLocation>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/java</sourceDirectory>
                        <sourceDirectory>${project.basedir}/tools/antisamy-trial/src/main/java</sourceDirectory>
                    </sourceDirectories>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <excludeGeneratedSources>true</excludeGeneratedSources>
                    <includeResources>false</includeResources>
                    <includeTestResources>false</includeTestResources>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                </configuration>
                <executions>
                    <execution>
                        <id>check-source-style</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <!-- Runtime framework annotations do not need a claiming processor. -->
                        <arg>-Xlint:all,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
