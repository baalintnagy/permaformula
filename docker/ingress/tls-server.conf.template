        listen unix:/tmp/permaformula-https.sock ssl proxy_protocol;
        # One in-flight URL per admitted TCP connection. HTTP/2 multiplexing
        # would multiply allocations before HTTP request admission executes.
        http2 off;
        # Only the local stream listener supplies client identity, never a
        # client-provided HTTP header or a network-accessible PROXY listener.
        set_real_ip_from unix:;
        real_ip_header proxy_protocol;
        server_name ${PERMAFORMULA_TLS_HOSTNAME};
        if ($host != ${PERMAFORMULA_TLS_HOSTNAME}) { return 421; }
        # nginx request error messages can contain the full formula/permalink.
        # Issuer/startup diagnostics still use the main error log.
        error_log /dev/null;
        acme_certificate permaformula;
        ssl_certificate $acme_certificate;
        ssl_certificate_key $acme_certificate_key;
        ssl_certificate_cache max=2 inactive=1h valid=5s;
