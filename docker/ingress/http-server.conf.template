    server {
        listen unix:/tmp/permaformula-http.sock proxy_protocol;
        set_real_ip_from unix:;
        real_ip_header proxy_protocol;
        server_name ${PERMAFORMULA_TLS_HOSTNAME};
        error_log /dev/null;
        # Certificate validation uses TLS-ALPN-01 on the HTTPS listener.
        location / {
            return 308 ${PERMAFORMULA_HOST}$request_uri;
        }
    }
    server {
        listen 127.0.0.1:8082;
        location = /health {
            return 200 'ok';
        }
        location / {
            return 404;
        }
    }
