root = true

[*]
indent_style = space
indent_size = 4
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.sh]
binary_next_line = true
switch_case_indent = true

[Makefile]
indent_style = tab
