# Copy to .env and choose distinct strong passwords before starting Docker Compose.
PERMMATH_CACHE_DB_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PERMMATH_CACHE_DB_PASSWORD=replace-with-a-different-strong-application-password
# Public HTTPS origin when deployed; localhost works for initial local Compose testing.
PERMMATH_HOST=http://localhost:5000
