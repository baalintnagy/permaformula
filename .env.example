# Copy to .env and choose distinct strong passwords before starting Docker Compose.
PERMAFORMULA_CACHE_DB_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PERMAFORMULA_CACHE_DB_PASSWORD=replace-with-a-different-strong-application-password
# Public HTTPS origin when deployed; localhost works for initial local Compose testing.
PERMAFORMULA_HOST=http://localhost:5000

# Optional dedicated PostgreSQL database.
PERMAFORMULA_CACHE_DATABASE=permaformula
